        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:danielukorie-debug@REPLACE_WITH_OWNER_ID/aws-iam-cloud-security-lab@REPLACE_WITH_REPOSITORY_ID:ref:refs/heads/main"
        }
      }
    }
  ]
